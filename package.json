{
  "name": "kimboxpc",
  "version": "3.9.3",
  "description": "KimBoxPC - 基于 TVBox / FongMi 协议的 Windows PC 播放客户端",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "build:native": "electron node_modules/node-gyp/bin/node-gyp.js rebuild --directory=native --target=45.2.3 --dist-url=https://electronjs.org/headers --arch=x64"
