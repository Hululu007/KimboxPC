  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^45.2.3"
  }
}
